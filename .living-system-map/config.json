{
  "schemaVersion": 1,
  "project": {
    "name": "ontrack",
    "accent": "#27d3a2"
  },
  "adapters": [
    "generic",
    "typescript",
    "expo-router",
    "jest-istanbul",
    "supabase",
    "native",
    "ui-flows"
  ],
  "sourceRoots": [
    "src"
  ],
  "additionalRoots": [
    "supabase",
    "modules",
    "plugins",
    "scripts",
    "cloudflare"
  ],
  "assetRoots": [
    "assets",
    "public"
  ],
  "projectFiles": [
    "app.json",
    "package.json",
    "eas.json",
    "babel.config.js",
    "metro.config.js",
    "eslint.config.js",
    "tsconfig.json",
    "tsconfig.test.json"
  ],
  "ignore": [
    "node_modules",
    ".git",
    "dist",
    "build",
    "coverage",
    ".expo",
    ".living-system-map/generated"
  ],
  "coverage": {
    "command": [
      "npm",
      "test",
      "--",
      "--coverage",
      "--runInBand",
      "--watchman=false",
      "--coverageReporters=json-summary",
      "--coverageReporters=text-summary",
      "--json",
      "--outputFile=.living-system-map/generated/jest-results.json",
      "--testLocationInResults",
      "--collectCoverageFrom=src/**/*.{ts,tsx}",
      "--collectCoverageFrom=!src/**/__tests__/**",
      "--collectCoverageFrom=!src/**/*.d.ts"
    ],
    "summaryPath": "coverage/coverage-summary.json"
  },
  "testResults": {
    "format": "jest-json",
    "path": ".living-system-map/generated/jest-results.json"
  },
  "health": {
    "lineCoverageWarning": 80,
    "branchCoverageWarning": 70
  },
  "flowProtection": {
    "manifestPath": ".living-system-map/flows.json",
    "resultsPath": ".living-system-map/generated/flow-runs.json",
    "mode": "observe",
    "observeUntil": "2026-08-20T23:59:59.000Z"
  },
  "runtimeAnalytics": {
    "command": ["node", "scripts/living-system-map-analytics.mjs"],
    "tagCatalogPath": ".living-system-map/analytics-tags.json",
    "refreshMs": 15000,
    "windows": [1, 7, 30, 90],
    "defaultWindow": 7,
    "defaultEnvironment": "production"
  },
  "runtimeAccounts": {
    "command": ["node", "scripts/living-system-map-accounts.mjs"]
  },
  "domains": [
    { "id": "account", "label": "Account", "paths": ["src/features/account"] },
    { "id": "auth", "label": "Authentication", "paths": ["src/features/auth"] },
    { "id": "calendar", "label": "Calendar", "paths": ["src/features/calendar", "src/features/calendar-import", "src/services/calendar"] },
    { "id": "daily", "label": "Today", "paths": ["src/features/daily-tracking"] },
    { "id": "finance", "label": "Finance", "paths": ["src/features/finance", "src/services/finance", "src/store/finance.ts"] },
    { "id": "food", "label": "Food", "paths": ["src/features/food", "src/services/food", "src/services/nutrition", "src/services/recipes"] },
    { "id": "games", "label": "Games", "paths": ["src/features/games"] },
    { "id": "health", "label": "Health", "paths": ["src/features/health", "src/services/health", "src/store/health.ts"] },
    { "id": "plants", "label": "Plants", "paths": ["src/features/plants", "src/services/plants", "src/store/plants.ts"] },
    { "id": "social", "label": "Social", "paths": ["src/features/social", "src/services/friends", "src/store/friends.ts"] },
    { "id": "todos", "label": "Lists", "paths": ["src/features/todos", "src/services/todos", "src/store/todos.ts", "src/store/todos-"] },
    { "id": "travel", "label": "Travel", "paths": ["src/features/travel", "src/services/travel", "src/store/travel.ts", "src/store/travel-"] },
    { "id": "vehicles", "label": "Vehicles", "paths": ["src/features/vehicles", "src/services/vehicles", "src/store/vehicles.ts"] },
    { "id": "vision-board", "label": "Vision Board", "paths": ["src/features/vision-board", "src/store/vision-board.ts"] },
    { "id": "workouts", "label": "Fitness", "paths": ["src/features/workouts"] },
    { "id": "cloud", "label": "Cloud & Sync", "paths": ["src/services/cloud"] },
    { "id": "platform", "label": "Platform", "paths": ["src/services/http", "src/services/storage", "src/services/notifications", "src/services/updates"] },
    { "id": "design-system", "label": "Design System", "paths": ["src/design-system", "src/components/primitives"] },
    { "id": "agent-ui", "label": "Agent UI", "paths": ["src/utils/agent-ui"] }
  ],
  "productAreas": [
    { "id": "today", "label": "Today", "summary": "Daily schedule, activities, events, and the day timeline.", "group": "Daily Life", "order": 10, "domains": ["daily", "events", "overview", "schedule"], "paths": ["src/app/(tabs)/(today)", "src/app/activity-form"], "flowPrefixes": ["today", "activity", "event-bout"] },
    { "id": "calendar", "label": "Calendar", "summary": "Calendar views, imports, connected calendars, and event planning.", "group": "Daily Life", "order": 20, "domains": ["calendar"], "paths": ["src/app/(tabs)/calendar", "src/app/api/calendar", "src/app/share-event"], "flowPrefixes": ["calendar"] },
    { "id": "lists", "label": "Lists", "summary": "Checklists, groceries, collaboration, and recipe imports.", "group": "Daily Life", "order": 30, "domains": ["todos"], "paths": ["src/app/(tabs)/to-do", "src/app/todos", "src/app/todo-", "src/app/l/"], "flowPrefixes": ["checklist", "grocery", "todo", "open-new-checklist"] },
    { "id": "food", "label": "Food", "summary": "Meals, recipes, pantry knowledge, nutrition, and food planning.", "group": "Wellbeing", "order": 40, "domains": ["food", "nutrition"], "paths": ["src/app/(tabs)/food", "src/app/food", "src/app/nutrition", "src/app/meal-", "src/app/recipe-imports"], "flowPrefixes": ["food", "nutrition", "recipe"] },
    { "id": "fitness", "label": "Fitness", "summary": "Workout discovery, training sessions, and scheduled gym activity.", "group": "Wellbeing", "order": 50, "domains": ["workouts"], "paths": ["src/app/(tabs)/workouts", "src/app/detail/gym-active"], "flowPrefixes": ["workout", "gym"] },
    { "id": "health", "label": "Health", "summary": "Health summaries, mood check-ins, contributing factors, and playbooks.", "group": "Wellbeing", "order": 60, "domains": ["health"], "paths": ["src/app/(tabs)/health", "src/app/health"], "flowPrefixes": ["health"] },
    { "id": "finance", "label": "Finance", "summary": "Money tracking, bills, subscriptions, savings, accounts, and tax preparation.", "group": "Planning", "order": 70, "domains": ["finance"], "paths": ["src/app/(tabs)/finance", "src/app/api/finance", "src/app/p/plaid"], "flowPrefixes": ["finance"] },
    { "id": "travel", "label": "Travel", "summary": "Trips, itineraries, stays, flights, travel tools, and partner connections.", "group": "Planning", "order": 80, "domains": ["travel", "partner", "share-import"], "paths": ["src/app/(tabs)/travel", "src/app/travel", "src/app/api/partner", "src/app/partner", "src/app/p/straiaway", "src/app/share-import", "src/app/invite/travel"], "flowPrefixes": ["travel", "trip", "open-new-trip"] },
    { "id": "plants", "label": "Plants", "summary": "Plant collection, care plans, identification, and watering history.", "group": "Planning", "order": 90, "domains": ["plants"], "paths": ["src/app/(tabs)/plants", "src/app/plant-analysis"], "flowPrefixes": ["plant"] },
    { "id": "vehicles", "label": "Vehicles", "summary": "Vehicle records, maintenance, parts, collaboration, and VIN tools.", "group": "Planning", "order": 100, "domains": ["vehicles"], "paths": ["src/app/(tabs)/vehicles", "src/app/api/vehicles", "src/app/v/"], "flowPrefixes": ["vehicle"] },
    { "id": "vision-board", "label": "Vision Board", "summary": "Goals, visual categories, canvas items, and saved inspiration.", "group": "Planning", "order": 110, "domains": ["vision-board"], "paths": ["src/app/(tabs)/vision-board", "src/app/vision-board"], "flowPrefixes": ["vision"] },
    { "id": "trackers", "label": "Trackers & Add-ons", "summary": "Optional product modules, tracker pins, and add-on discovery.", "group": "Planning", "order": 120, "domains": ["addons", "trackers", "tab"], "paths": ["src/app/(tabs)/trackers", "src/addons"], "flowPrefixes": ["tracker", "addon"] },
    { "id": "social", "label": "Social", "summary": "Friends, invitations, sharing, and collaborative activity.", "group": "Community", "order": 130, "domains": ["social"], "paths": ["src/app/(tabs)/social", "src/app/f/", "src/app/i/", "src/app/c/", "src/app/j/"], "flowPrefixes": ["social", "friend"] },
    { "id": "games", "label": "Games", "summary": "Games, entertainment discovery, and playful shared experiences.", "group": "Community", "order": 140, "domains": ["games", "movies"], "paths": ["src/app/(tabs)/games", "src/app/games", "src/app/api/movies"], "flowPrefixes": ["game", "movie"] },
    { "id": "account", "label": "Account & Access", "summary": "Identity, profile, authentication, preferences, integrations, and developer access.", "group": "Account", "order": 150, "domains": ["account", "auth", "preferences"], "paths": ["src/app/(tabs)/profile", "src/app/auth", "src/app/account", "src/app/onboarding", "src/app/welcome", "src/app/integrations", "src/app/developer", "src/app/api-usage"], "flowPrefixes": ["profile", "account", "auth", "avatar", "open-developer", "open-home-location"] }
  ],
  "criticalPatterns": [
    "auth",
    "account",
    "permission",
    "sync",
    "storage",
    "payment",
    "finance",
    "delete",
    "purge",
    "collaboration"
  ],
