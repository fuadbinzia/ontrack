{
  "name": "ontrack",
  "main": "expo-router/entry",
  "version": "1.0.105",
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.110.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "chrono-node": "^2.9.1",
    "d3-geo": "^3.1.1",
    "expo": "~57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.10",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.7",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "~57.0.8",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.2",
    "i18n-iso-countries": "^7.14.0",
    "ical.js": "^2.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.4",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-swipeable-item": "^2.0.9",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "reanimated-color-picker": "^5.1.2",
    "topojson-client": "^3.1.0",
    "use-sync-external-store": "^1.6.0",
    "world-atlas": "^2.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/d3-geo": "^3.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "bash ./scripts/start-metro.sh",
    "start:clear": "bash ./scripts/start-metro.sh --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "bash ./scripts/start-metro.sh --android",
    "ios": "bash ./scripts/start-metro.sh --ios",
    "web": "bash ./scripts/start-metro.sh --web",
    "optimize": "node ./scripts/performance-audit.mjs --fix && npm run optimize:assets && node ./scripts/performance-audit.mjs",
    "optimize:audit": "node ./scripts/performance-audit.mjs",
    "optimize:assets": "node ./scripts/optimize-assets.mjs",
    "lint": "npm run lint:tokens && npm run lint:code",
    "lint:code": "eslint .",
    "lint:tokens": "npm run test:token-budget",
    "test:token-budget": "WATCHMAN_DISABLE=1 jest --watchman=false src/design-system/__tests__/token-budget.test.ts",
    "test": "jest",
    "typecheck": "bash scripts/ensure-metro-hmr-beacon.sh && tsc --noEmit",
    "typecheck:tests": "bash scripts/ensure-metro-hmr-beacon.sh && tsc -p tsconfig.test.json --noEmit",
    "update:testflight": "npx eas-cli@latest update --channel testflight --environment preview",
    "update:device": "npx eas-cli@latest update --channel device --environment preview",
    "update:production": "npx eas-cli@latest update --channel production --environment production",
    "build:device:android": "npx eas-cli@latest build --platform android --profile device --non-interactive",
    "ios:ensure-codesign": "bash ./scripts/ensure-ios-simulator-codesign.sh",
    "ios:resign-sim": "node ./scripts/resign-ios-simulator-app.js",
    "ios:run": "bash ./scripts/ensure-ios-simulator-codesign.sh && expo run:ios --device \"${ONTRACK_IOS_SIMULATOR:-onTrack iPhone 17 Pro}\" && bash ./scripts/update-virtual-devices.sh --ios --install-only",
    "ios:update-simulators": "bash ./scripts/update-virtual-devices.sh --ios",
    "android:ensure": "bash ./scripts/ensure-android-emulator.sh",
    "android:ensure:window": "bash ./scripts/ensure-android-emulator.sh --window",
    "android:ensure:start": "bash ./scripts/ensure-packager.sh --start --android",
    "android:run": "bash ./scripts/ensure-android-emulator.sh --window && expo run:android --device \"$(cat .cursor/android-emulator.serial 2>/dev/null || true)\" && bash ./scripts/update-virtual-devices.sh --android --install-only",
    "android:update-emulators": "bash ./scripts/update-virtual-devices.sh --android",
    "virtual-devices:update": "bash ./scripts/update-virtual-devices.sh",
    "android:push-fixture": "bash ./scripts/android-push-fixture.sh",
    "android:release-to-drive": "bash ./scripts/android-release-to-drive.sh",
    "ship:push": "bash ./scripts/ship-push.sh",
    "android:travel-demo": "bash ./scripts/agent-ui-android-travel-demo.sh",
    "agent-ui:verify-both": "bash ./scripts/agent-ui-verify-both.sh",
    "agent-ui:ios-alerts": "bash ./scripts/agent-ui-ios-alerts.sh",
    "build:testflight": "npm run optimize && npx eas-cli@latest build --platform ios --profile testflight --non-interactive --auto-submit",
    "packager:ensure": "bash ./scripts/ensure-packager.sh",
    "packager:ensure:start": "bash ./scripts/ensure-packager.sh --start",
    "packager:ensure:android": "bash ./scripts/ensure-packager.sh --start --android",
    "agent-ui:sources": "bash ./scripts/agent-ui-sources.sh",
    "system-map": "node ~/.codex/skills/living-system-map/scripts/atlas.mjs serve --repo .",
    "system-map:scan": "node ~/.codex/skills/living-system-map/scripts/atlas.mjs scan --repo .",
    "system-map:verify": "node ~/.codex/skills/living-system-map/scripts/atlas.mjs verify --repo .",
    "system-map:coverage": "node ~/.codex/skills/living-system-map/scripts/atlas.mjs coverage --repo .",
    "system-map:check": "node ~/.codex/skills/living-system-map/scripts/atlas.mjs check --repo .",
    "system-map:baseline": "node ~/.codex/skills/living-system-map/scripts/atlas.mjs baseline --repo .",
    "system-map:analytics": "node scripts/living-system-map-analytics.mjs",
    "flow-proof": "node scripts/agent-ui-flow-proof-batch.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(ts|tsx)"
    ],
    "transform": {
      "\\.mjs$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|d3-geo|d3-array|internmap))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFiles": [
      "react-native-gesture-handler/jestSetup"
    ]
  },
  "private": true
}
