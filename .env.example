# Public client configuration. These values are bundled into the app.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_LIVE_FLIGHT_SEARCH_ENABLED=false
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Product support contact shown in privacy / terms (never a personal inbox in source).
# EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
# Direct crash-report delivery (server-only). CRASH_REPORT_TO_EMAIL falls back to
# EXPO_PUBLIC_SUPPORT_EMAIL; the sender must use a domain verified by Resend.
RESEND_API_KEY=
CRASH_REPORT_TO_EMAIL=support@example.com
CRASH_REPORT_FROM_EMAIL=onTrack Crash Reports <crash-reports@example.com>
# Optional separate origin for Expo Router recipe-analysis API routes.
EXPO_PUBLIC_RECIPE_API_URL=https://api.example.com

# Stable EAS Hosting alias used by Apple Universal Links.
EXPO_PUBLIC_TRAVEL_SHARE_BASE_URL=https://ontrack--links.expo.app

# Comma-separated browser origins allowed to call Expo API routes / edge functions.
# Native apps omit Origin and are unaffected. Never use *.
ALLOWED_ORIGINS=https://ontrack--links.expo.app

# Server-only Supabase identity for Expo Router API route auth (api-auth.ts).
# Prefer the same project as EXPO_PUBLIC_*; never ship the service-role key here.
# Local Metro falls back to EXPO_PUBLIC_* when these are omitted.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Local-only: allow paid API routes when Supabase auth config is unset. Never set in production.
# ALLOW_UNAUTHENTICATED_API=true

# Agent verification accounts (agent_1…agent_4) — dev only, one per agent device
# (iOS slots 1-2 → 1/2, Android slots 1-2 → 3/4). Real values belong in the
# gitignored .env.local; `./scripts/agent-accounts-setup.sh` creates the users,
# sets account_flags.agent_test, and writes generated passwords there.
# Sign-in is refused in release builds and for any account without agent_test.
# SUPABASE_SERVICE_ROLE_KEY=            # setup script only; never bundled
# ONTRACK_AGENT_ACCOUNT_EMAIL_DOMAIN=example.com
# ONTRACK_AGENT_ACCOUNT_1_EMAIL=agent_1@example.com
# ONTRACK_AGENT_ACCOUNT_1_PASSWORD=
# ONTRACK_AGENT_ACCOUNT_PASSWORD=       # shared fallback for all four accounts
# Optional operator override (gitignored .env.local only — never commit emails):
# ONTRACK_AGENT_LOGIN_EMAIL=
# ONTRACK_AGENT_LOGIN_PASSWORD=

# Server-only provider credentials. Never prefix these with EXPO_PUBLIC_.
TMDB_READ_ACCESS_TOKEN=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Use "test" for cached sandbox data or "production" for real-time availability and prices.
AMADEUS_ENVIRONMENT=test
# Server-only RapidAPI key for AeroDataBox's free flight-status plan.
AERODATABOX_API_KEY=

# Google Calendar two-way sync (server-only). The callback registered in Google
# Cloud must be: https://<your-api-origin>/api/calendar/google/callback
# Native development uses the hosted API because Metro must not receive the
# server-only credentials below.
EXPO_PUBLIC_CALENDAR_API_BASE_URL=https://ontrack.expo.app
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://ontrack.expo.app/api/calendar/google/callback
GOOGLE_CALENDAR_STATE_SECRET=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Required by calendar API routes to store encrypted OAuth credentials.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only HMAC key for anonymous analytics install/session identifiers.
ANALYTICS_INSTALL_HASH_SECRET=

# Plaid Hosted Link + server-side Item vault. Register PLAID_REDIRECT_URI in
# the Plaid Dashboard. Keep credentials and the encryption key server-only.
EXPO_PUBLIC_FINANCE_API_BASE_URL=https://ontrack.expo.app
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=https://ontrack--links.expo.app/p/plaid
PLAID_TOKEN_ENCRYPTION_KEY=
# Optional web callback; native uses ontrack://plaid/complete.
# PLAID_WEB_COMPLETION_REDIRECT_URI=https://ontrack.expo.app/finance/accounts?plaid=complete

# Recipe extraction is server-only and disabled until explicitly enabled.
RECIPE_AI_ENABLED=false
# Optional. When omitted, recipe analysis inherits MEAL_AI_PROVIDER.
# Use "ollama" for the free local provider, or "openai" for the hosted provider.
RECIPE_AI_PROVIDER=
# Optional recipe-only local gate/model. When omitted, the existing
# LOCAL_MEAL_AI_ENABLED and OLLAMA_MEAL_MODEL settings are reused.
LOCAL_RECIPE_AI_ENABLED=
OLLAMA_RECIPE_MODEL=
OPENAI_API_KEY=
# Optional travel translator model; defaults to a low-latency multilingual model.
OPENAI_TRAVEL_TRANSLATOR_MODEL=
# Optional; otherwise recipe analysis reuses OPENAI_MEAL_MODEL.
OPENAI_RECIPE_MODEL=
