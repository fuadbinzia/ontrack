{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ontrack-teller-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TELLER_USE_MTLS": "true"
  },
  "mtls_certificates": [
    {
      "binding": "TELLER_MTLS",
      "certificate_id": "d619d916-5bb9-4f06-9530-48b175d7da19",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TELLER_REPLAY",
      "id": "c0478f8c984444d1855251c4dd541ec5"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
