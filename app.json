{
  "expo": {
    "name": "onTrack",
    "slug": "onTrack",
    "version": "1.0.135",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ontrack",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "1.0.3",
    "updates": {
      "url": "https://u.expo.dev/bd232bf6-7397-4463-b25a-9b67d78e5695",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 8000,
      "requestHeaders": {
        "expo-channel-name": "device"
      }
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.imtihoss.ontracknow",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:ontrack--links.expo.app"
      ],
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "E-ZPass Statement",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.comma-separated-values-text",
              "public.tab-separated-values-text",
              "com.microsoft.excel.xls",
              "org.openxmlformats.spreadsheetml.sheet",
              "com.adobe.pdf"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false,
        "NSCameraUsageDescription": "onTrack uses the camera to capture meal, activity, plant-care, and vision-board photos, plus avatars, travel confirmations, E-ZPass statements, and tax documents.",
        "NSMicrophoneUsageDescription": "onTrack uses the microphone for dock search voice, journal voice notes, journal dictation, and short travel translations you choose to record.",
        "NSPhotoLibraryUsageDescription": "onTrack accesses your photo library so you can attach meal, activity, plant-care, and vision-board photos, plus avatars, travel confirmations, E-ZPass statements, and tax documents.",
        "NSMotionUsageDescription": "onTrack uses the motion sensors so Today activity cards can detect movement and so the travel sky can twinkle as you tilt the phone.",
        "NSFaceIDUsageDescription": "onTrack uses Face ID to unlock your signed-in session on this device.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "straiaway"
        ]
      },
      "appleTeamId": "F5HRXF5795"
    },
    "android": {
      "versionCode": 135,
      "package": "com.imtihoss.ontracknow",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ontrack--links.expo.app",
              "pathPrefix": "/l/"
            },
            {
              "scheme": "https",
              "host": "ontrack--links.expo.app",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "ontrack--links.expo.app",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "ontrack--links.expo.app",
              "pathPrefix": "/f/"
            },
            {
              "scheme": "https",
              "host": "ontrack--links.expo.app",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "ontrack--links.expo.app",
              "pathPrefix": "/v/"
            },
            {
              "scheme": "https",
              "host": "ontrack--links.expo.app",
              "pathPrefix": "/p/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cache-Control": "public, max-age=0, s-maxage=300, stale-while-revalidate=3600, stale-if-error=86400"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "onTrack accesses your photos so you can attach meal, activity, plant-care, and vision-board photos, plus avatars, travel confirmations, E-ZPass statements, and tax documents.",
          "cameraPermission": "onTrack uses the camera to capture meal, activity, plant-care, and vision-board photos, plus avatars, travel confirmations, E-ZPass statements, and tax documents.",
          "microphonePermission": "onTrack uses the microphone for dock search voice, journal voice notes, journal dictation, and short travel translations you choose to record."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-dev-client",
        {
          "skipOnboarding": true,
          "showMenuAtLaunch": false,
          "toolsButton": false
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "onTrack uses Face ID to unlock your signed-in session on this device."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "onTrack uses the motion sensors so Today activity cards can detect movement and so the travel sky can twinkle as you tilt the phone."
        }
      ],
      "./plugins/with-ontrack-healthkit.js",
      "./plugins/with-ontrack-voice-lists.js",
      "./plugins/with-ontrack-document-open.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "onTrack uses your approximate location for Today weather and to suggest a departure city for travel searches."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "event-chat"
        }
      ],
      "./plugins/with-simulator-keychain-codesign.js",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1,
              "supportsImageWithMaxCount": 1,
              "supportsFileWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "text/csv",
              "text/tab-separated-values",
              "text/uri-list",
              "text/calendar",
              "application/ics",
              "application/vnd.ms-excel",
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
              "application/pdf",
              "image/*"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "onTrack uses the microphone for dock search voice, journal voice notes, journal dictation, and short travel translations you choose to record.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd232bf6-7397-4463-b25a-9b67d78e5695"
      }
    },
    "owner": "imtihoss"
  }
}
